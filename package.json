{
  "name": "universe-template-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Universe Template Studio - Web-first Template Designer & Document Generation Engine",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
